# ===== LLM PROVIDERS =====
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Optional: if your main model doesn't support tool-calling, set a tools-capable model here
OPENROUTER_TOOLS_MODEL=anthropic/claude-3.5-sonnet
# Optional: model for image analysis in Telegram photo messages
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# Hermes (OpenAI-compatible endpoint)
# Example local endpoint: http://localhost:11434/v1
# Example cloud endpoint: https://your-hermes-endpoint/v1
HERMES_BASE_URL=http://localhost:11434/v1
HERMES_API_KEY=your_hermes_api_key
HERMES_MODEL=hermes-3-llama-3.1-70b

# Active LLM provider: "groq" | "openrouter" | "hermes"
LLM_PROVIDER=groq

# ===== IMAGENES (generate_image) =====
# Opcion A — Kie.ai (créditos en kie.ai): https://kie.ai/api-key
KIE_API_KEY=
# Opcion B — OpenAI DALL-E: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Si tienes ambas, elige: kie | openai (si vacio: usa KIE si existe KIE_API_KEY, si no OpenAI)
# IMAGE_GENERATION_PROVIDER=
# IMAGE_GENERATION_API_KEY=
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_QUALITY=standard
# Kie: polling (ms), opcional
# KIE_IMAGE_POLL_MAX_MS=180000
# KIE_IMAGE_POLL_INTERVAL_MS=3000

# ===== WEB SEARCH (optional, recomendado para datos de internet) =====
# Serper: https://serper.dev  |  Tavily: https://tavily.com
SERPER_API_KEY=
TAVILY_API_KEY=

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ===== EMAIL =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM=your@email.com

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your@email.com
IMAP_PASS=your_app_password

# ===== GOOGLE (Gmail + Drive API via OAuth2) =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Optional: default parent folder where new Drive folders are created
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Tras habilitar Sheets + Calendar en Cloud Console, regenera GOOGLE_REFRESH_TOKEN con los scopes del README.

# ===== LINKEDIN (OAuth2 — publicar posts con aprobacion /li_approve en Telegram) =====
# Crea una app en https://www.linkedin.com/developers/apps
# Productos: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# Scopes: openid, profile, w_member_social (y email si lo pides en el flujo)
# Opcion A — refresh (si LinkedIn te lo devuelve en el JSON del accessToken):
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=
# Opcion B — sin refresh_token: pega aqui el access_token del JSON (LinkedIn suele dar ~60 dias, expires_in en segundos)
# LINKEDIN_ACCESS_TOKEN=
# Opcional: cuando caduca el access_token (epoch ms). Ej.: al obtener el token, Date.now() + expires_in*1000
# LINKEDIN_ACCESS_TOKEN_EXPIRES_AT_MS=
# Opcional: fijar URN y evitar userinfo (urn:li:person:XXXX)
# LINKEDIN_PERSON_URN=

# ===== MCP SERVER =====
MCP_PORT=3100

# ===== AGENT =====
AGENT_NAME=AgenteZirox
AGENT_VERSION=1.0.0
# Perfil del usuario (inyectado en cada mensaje al modelo). Opcional.
USER_DISPLAY_NAME=
# Texto libre: gustos, tono preferido, idioma, etc. También puede crecer vía tool remember_about_user.
USER_PROFILE=

# Secreto compartido para crons internos (Bearer o x-cron-secret). Si vacío, usa SELF_IMPROVE_CRON_SECRET.
# CRON_SECRET=

# Tareas programadas (recordatorios)
SCHEDULED_TASKS_ENABLED=false
# Ticker dentro del proceso server.ts cada 60s (por defecto true). Pon false si solo quieres HTTP cron.
# SCHEDULED_TASKS_INTERNAL_TICKER=true
# Intervalo en ms (15000–300000), por defecto 60000
# SCHEDULED_TASKS_TICK_MS=60000

# Auto-mejora diaria: resume el chat y añade viñetas al perfil (metadata). Cron HTTP a /api/cron/self-improve
SELF_IMPROVE_ENABLED=false
SELF_IMPROVE_CRON_SECRET=
# SELF_IMPROVE_WINDOW_HOURS=36
# SELF_IMPROVE_MIN_USER_MESSAGES=4
# SELF_IMPROVE_MAX_ROWS=220
# SELF_IMPROVE_MAX_TRANSCRIPT_CHARS=14000

# Workspace seguro para operaciones de archivos del agente (VPS)
WORKSPACE_BASE_DIR=/opt/zirox-workspace
