# ===== LLM PROVIDERS =====
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Optional: if your main model doesn't support tool-calling, set a tools-capable model here
OPENROUTER_TOOLS_MODEL=anthropic/claude-3.5-sonnet
# Optional: model for image analysis in Telegram photo messages
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# Hermes (OpenAI-compatible endpoint)
# Example local endpoint: http://localhost:11434/v1
# Example cloud endpoint: https://your-hermes-endpoint/v1
HERMES_BASE_URL=http://localhost:11434/v1
HERMES_API_KEY=your_hermes_api_key
HERMES_MODEL=hermes-3-llama-3.1-70b

# Active LLM provider: "groq" | "openrouter" | "hermes"
LLM_PROVIDER=groq

# ===== IMAGENES (generate_image) =====
# Opcion A — Kie.ai (créditos en kie.ai): https://kie.ai/api-key
KIE_API_KEY=
# Opcion B — OpenAI DALL-E: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Si tienes ambas, elige: kie | openai (si vacio: usa KIE si existe KIE_API_KEY, si no OpenAI)
# IMAGE_GENERATION_PROVIDER=
# IMAGE_GENERATION_API_KEY=
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_QUALITY=standard
# Kie: modelo a usar (API unificada /api/v1/jobs/createTask). Default: flux-2/pro-text-to-image
# Modelos disponibles en https://kie.ai → AI Image API:
#   flux-2/pro-text-to-image     → Flux 2 Pro (fotorrealista, recomendado)
#   seedream-v3/text-to-image    → Seedream 4.5
#   ideogram-v3/text-to-image    → Ideogram V3 (bueno para texto en imágenes)
#   grok-imagine/text-to-image   → Grok Imagine
#   imagen-4/text-to-image       → Imagen 4 (Google)
# KIE_IMAGE_MODEL=flux-2/pro-text-to-image
# Kie: polling (ms), opcional
# KIE_IMAGE_POLL_MAX_MS=180000
# KIE_IMAGE_POLL_INTERVAL_MS=5000

# ===== WEB SEARCH (optional, recomendado para datos de internet) =====
# Serper: https://serper.dev  |  Tavily: https://tavily.com
SERPER_API_KEY=
TAVILY_API_KEY=

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Tu chat ID personal de Telegram — para recibir notificaciones de WhatsApp
# Encuéntralo hablándole a @userinfobot en Telegram
TELEGRAM_OWNER_CHAT_ID=

# ===== MEMORIA (opcional — escala / varias réplicas) =====
# Si defines ambas, el agente usa Postgres en Supabase en lugar de SQLite local.
# 1) Crea proyecto en https://supabase.com
# 2) SQL Editor → pega y ejecuta supabase/migrations/001_agent_memory.sql
# 3) Settings → API: Project URL + service_role (solo servidor, nunca en el cliente)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ===== EMAIL =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM=your@email.com

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your@email.com
IMAP_PASS=your_app_password

# ===== GOOGLE (Gmail + Drive API via OAuth2) =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Optional: default parent folder where new Drive folders are created
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Tras habilitar Sheets + Calendar en Cloud Console, regenera GOOGLE_REFRESH_TOKEN con los scopes del README.

# ===== LINKEDIN (OAuth2 — publicar posts con aprobacion /li_approve en Telegram) =====
# Crea una app en https://www.linkedin.com/developers/apps
# Productos: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# Scopes: openid, profile, w_member_social (y email si lo pides en el flujo)
# Opcion A — refresh (si LinkedIn te lo devuelve en el JSON del accessToken):
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=
# Opcion B — sin refresh_token: pega aqui el access_token del JSON (LinkedIn suele dar ~60 dias, expires_in en segundos)
# LINKEDIN_ACCESS_TOKEN=
# Opcional: cuando caduca el access_token (epoch ms). Ej.: al obtener el token, Date.now() + expires_in*1000
# LINKEDIN_ACCESS_TOKEN_EXPIRES_AT_MS=
# Opcional: fijar URN y evitar userinfo (urn:li:person:XXXX)
# LINKEDIN_PERSON_URN=

# ===== WHATSAPP (Meta Cloud API) =====
# Crea una app en https://developers.facebook.com → WhatsApp → Getting Started
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v19.0
# Token secreto que tú eliges — debe coincidir con el que pongas en Meta Developers → Webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ===== CONTROL DE ESCRITORIO (Windows local — inspirado en JARVIS) =====
# El agente debe ejecutarse en TU PC (npm run dev), no en un VPS remoto.
DESKTOP_CONTROL_ENABLED=true
# Permite abrir rutas absolutas fuera del perfil del usuario (cuidado)
# DESKTOP_CONTROL_ALLOW_ANY_PATH=false
# Carpeta de trabajo para create_folder / write_file (en Windows usa ruta local)
# WORKSPACE_BASE_DIR=C:\Users\tu_usuario\zirox-workspace

# ===== MCP SERVER =====
MCP_PORT=3100

# ===== AGENT =====
AGENT_NAME=AgenteZirox
AGENT_VERSION=1.0.0
# Perfil del usuario (inyectado en cada mensaje al modelo). Opcional.
USER_DISPLAY_NAME=
# Texto libre: gustos, tono preferido, idioma, etc. También puede crecer vía tool remember_about_user.
USER_PROFILE=

# Secreto compartido para crons internos (Bearer o x-cron-secret). Si vacío, usa SELF_IMPROVE_CRON_SECRET.
# CRON_SECRET=

# Canva MCP: se configura en ~/.cursor/mcp.json (OAuth en Cursor, no en este .env)

# Memoria persistente de tareas (n8n → zirox_2026 | Memoria de Tareas del Agente)
N8N_AGENT_TASKS_ENABLED=true
# N8N_AGENT_TASKS_WEBHOOK_URL=https://ziroxxn8n.ziroxn8n.site/webhook/agent-tareas-memoria

# Crear infografías (n8n + render PNG automático en el agente)
N8N_CREATE_INFOGRAPHIC_ENABLED=true
# N8N_CREATE_INFOGRAPHIC_WEBHOOK_URL=https://ziroxxn8n.ziroxn8n.site/webhook/agent-crear-infografia
# AntV Infographic (@antv/infographic) — render PNG vía Playwright + CDN en el agente
# En el VPS tras deploy: npx playwright install chromium
# Alternativa sin Chromium: HCTI_USER_ID + HCTI_API_KEY (https://htmlcsstoimage.com)
# Estilo infografía: pro (2 columnas, fondo claro, tipo NotebookLM) | grid | sequence
INFOGRAPHIC_STYLE=pro
# INFOGRAPHIC_ANTV_TEMPLATE=list-grid-badge-card
# INFOGRAPHIC_ANTV_TEMPLATE=sequence-ascending-steps

# Infografías premium con Google NotebookLM (API no oficial — notebooklm-py)
NOTEBOOKLM_ENABLED=false
# NOTEBOOKLM_PYTHON=python3
# NOTEBOOKLM_SCRIPT_PATH=scripts/notebooklm-generate-infographic.py
# NOTEBOOKLM_AUDIO_SCRIPT_PATH=scripts/notebooklm-generate-audio.py
# NOTEBOOKLM_AUDIO_TIMEOUT_MS=900000
# NOTEBOOKLM_STORAGE_PATH=/root/.notebooklm/storage_state.json
# NOTEBOOKLM_STYLE=editorial
# NOTEBOOKLM_TIMEOUT_MS=660000
# NOTEBOOKLM_INTERNAL_SECRET=  # Bearer para POST /api/internal/notebooklm/infographic
N8N_NOTEBOOKLM_INFOGRAPHIC_ENABLED=true
# N8N_NOTEBOOKLM_INFOGRAPHIC_WEBHOOK_URL=https://ziroxxn8n.ziroxn8n.site/webhook/agent-infografia-notebooklm

# Tareas programadas (recordatorios con ejecución automática)
SCHEDULED_TASKS_ENABLED=false
# Ticker dentro del proceso server.ts cada 60s (por defecto true). Pon false si solo quieres HTTP cron.
# SCHEDULED_TASKS_INTERNAL_TICKER=true
# Intervalo en ms (15000–300000), por defecto 60000
# SCHEDULED_TASKS_TICK_MS=60000

# Auto-mejora diaria: resume el chat y añade viñetas al perfil (metadata). Cron HTTP a /api/cron/self-improve
SELF_IMPROVE_ENABLED=false
SELF_IMPROVE_CRON_SECRET=
# SELF_IMPROVE_WINDOW_HOURS=36
# SELF_IMPROVE_MIN_USER_MESSAGES=4
# SELF_IMPROVE_MAX_ROWS=220
# SELF_IMPROVE_MAX_TRANSCRIPT_CHARS=14000

# Workspace seguro para operaciones de archivos del agente (VPS)
WORKSPACE_BASE_DIR=/opt/zirox-workspace
